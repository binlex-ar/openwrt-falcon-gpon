#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenWrt.org

START=85
USE_PROCD=1

PROG=/usr/sbin/omcid

start_service() {
	local mib_file="/etc/mibs/data_1v_8q.ini"
	local log_level="3"
	local omcc_ver="160"
	local iop_mask="0"

	# If PPTP template is preferred, check if user specified it
	if [ -f /etc/config/omcid ]; then
		config_load omcid
		config_get mib_file main mib_file "$mib_file"
		config_get log_level main log_level "$log_level"
		config_get omcc_ver main omcc_ver "$omcc_ver"
		config_get iop_mask main iop_mask "$iop_mask"
	fi

	mkdir -p /tmp/log /tmp/pipe

	procd_open_instance
	procd_set_param command "$PROG" -d "$log_level" -p "$mib_file" -o "$omcc_ver" -i "$iop_mask" -l /tmp/log/omcid.log
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall omcid 2>/dev/null
}
